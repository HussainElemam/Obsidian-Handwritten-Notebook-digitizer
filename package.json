{
  "name": "obsidian-notebook-digitizer",
  "version": "1.0.0",
  "description": "Digitize handwritten notebook pages in any language into structured Markdown notes using the Gemini API.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "esbuild test/verify.ts --bundle --platform=node --external:obsidian | node",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ocr",
    "gemini",
    "handwriting",
    "multilingual",
    "digitizer",
    "notes"
  ],
  "author": "Hussain Elemam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
